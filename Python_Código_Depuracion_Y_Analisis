#Codigo utilisado para la depuracion y analisis
import os
import re
import unicodedata

from pyspark.sql import SparkSession
from pyspark.sql.functions import (
    col, trim, lower, when, lit, count, avg,
    sum as spark_sum, round as spark_round,
    to_date, coalesce, substring, date_format,
    datediff, upper
)

spark = SparkSession.builder.appName("AnalisisCOVIDColombia").getOrCreate()
spark.sparkContext.setLogLevel("WARN")

ENTRADA = "/home/vboxuser/casos_covid_1M.csv"
SALIDA = "/home/vboxuser/resultados_1M"

# 1. Leer como máximo un millón de registros
original = (
    spark.read.option("header", True)
    .option("encoding", "UTF-8")
    .option("inferSchema", False)
    .csv(ENTRADA)
    .limit(1_000_000)
)

def normalizar(nombre):
    nombre = unicodedata.normalize("NFKD", nombre)
    nombre = "".join(c for c in nombre if not unicodedata.combining(c))
    return re.sub(r"[^a-z0-9]+", "_", nombre.lower()).strip("_")

for nombre in original.columns:
    nuevo = normalizar(nombre)
    if nombre != nuevo:
        original = original.withColumnRenamed(nombre, nuevo)

print("Columnas detectadas:", original.columns)

columnas = set(original.columns)

def buscar(*opciones):
    for opcion in opciones:
        if opcion in columnas:
            return opcion
    return None

c_id = buscar("id_de_caso", "id_caso")
c_dep = buscar("departamento_nom", "nombre_departamento")
c_sexo = buscar("sexo")
c_edad = buscar("edad")
c_unidad = buscar("unidad_medida", "unidad_de_medida")
c_not = buscar("fecha_de_notificaci_n", "fecha_de_notificacion",
               "fecha_notificacion")
c_inicio = buscar("fecha_inicio_sintomas", "fecha_de_inicio_de_sintomas")
c_muerte = buscar("fecha_muerte", "fecha_de_muerte")
c_estado = buscar("estado")
c_ubicacion = buscar("ubicacion")

def campo(nombre):
    origen = buscar(nombre)
    return col(origen).cast("string") if origen else lit(None).cast("string")

# Conteo de registros del archivo seleccionado
total_original = original.count()

df = original.select(
    campo("id_de_caso").alias("id_caso"),
    (col(c_dep).cast("string") if c_dep else lit(None).cast("string"))
        .alias("departamento"),
    campo("sexo").alias("sexo"),
    campo("edad").alias("edad_texto"),
    campo("unidad_medida").alias("unidad_edad"),
    campo("fecha_de_notificaci_n").alias("notificacion_texto"),
    campo("fecha_inicio_sintomas").alias("inicio_texto"),
    campo("fecha_muerte").alias("muerte_texto"),
    campo("estado").alias("estado"),
    campo("ubicacion").alias("ubicacion")
)

# Depurar textos, edades y fechas.
def fecha(texto):
    return coalesce(
        to_date(substring(col(texto), 1, 10), "yyyy-MM-dd"),
        to_date(substring(col(texto), 1, 10), "dd/MM/yyyy")
    )

df = (
    df.withColumn("departamento", upper(trim(col("departamento"))))
      .withColumn("sexo", upper(trim(col("sexo"))))
      .withColumn("estado", lower(trim(col("estado"))))
      .withColumn("ubicacion", lower(trim(col("ubicacion"))))
      .withColumn("edad_num", col("edad_texto").cast("double"))
      .withColumn("notificacion", fecha("notificacion_texto"))
      .withColumn("inicio_sintomas", fecha("inicio_texto"))
      .withColumn("fecha_muerte", fecha("muerte_texto"))
      .withColumn(
          "departamento",
          when(col("departamento").isNull() |
               (col("departamento") == ""), "No informado")
          .otherwise(col("departamento"))
      )
      .withColumn(
          "sexo",
          when(col("sexo").isNull() | (col("sexo") == ""), "No informado")
          .otherwise(col("sexo"))
      )
)

df = df.withColumn(
    "edad_anios",
    when(col("unidad_edad") == "1", col("edad_num"))
    .when(col("unidad_edad") == "2", col("edad_num") / 12.0)
    .when(col("unidad_edad") == "3", col("edad_num") / 365.0)
    .otherwise(col("edad_num"))
)

# Quitar registros completamente duplicados
duplicados = total_original - df.dropDuplicates().count()
df = df.dropDuplicates()
total_limpio = df.count()

# 2. Grupos de edad que se tomaran para realisar los analisis 
df = df.withColumn(
    "grupo_edad",
    when(col("edad_anios").between(0, 9.999), "00-09")
    .when(col("edad_anios").between(10, 19.999), "10-19")
    .when(col("edad_anios").between(20, 29.999), "20-29")
    .when(col("edad_anios").between(30, 39.999), "30-39")
    .when(col("edad_anios").between(40, 49.999), "40-49")
    .when(col("edad_anios").between(50, 59.999), "50-59")
    .when(col("edad_anios").between(60, 69.999), "60-69")
    .when(col("edad_anios").between(70, 79.999), "70-79")
    .when(col("edad_anios") >= 80, "80+")
    .otherwise("No informada")
)

# Definir fallecimiento
df = df.withColumn(
    "fallecido",
    when(
        col("fecha_muerte").isNotNull()
        | (col("estado").contains("fallecido"))
        | (col("ubicacion").contains("fallecido")),
        1
    ).otherwise(0)
)



# PREGUNTA 1: casos por departamento y mes
tabla1 = (
    df.filter(col("notificacion").isNotNull())
    .withColumn("mes", date_format(col("notificacion"), "yyyy-MM"))
    .groupBy("departamento", "mes")
    .agg(count("*").alias("total_casos"))
    .orderBy(col("total_casos").desc())
)

total_departamento = (
    df.groupBy("departamento")
    .agg(count("*").alias("total_casos"))
    .orderBy(col("total_casos").desc())
)



# PREGUNTA 2: casos por edad y sexo
tabla2 = (
    df.filter(col("grupo_edad") != "No informada")
    .groupBy("grupo_edad", "sexo")
    .agg(count("*").alias("casos"))
    .orderBy("grupo_edad", "sexo")
)



# PREGUNTA 3: casos, fallecidos y letalidad por edad
# Se muestran los nueve rangos aunque alguno tenga cero registros.
grupos = [
    ("00-09",), ("10-19",), ("20-29",), ("30-39",),
    ("40-49",), ("50-59",), ("60-69",), ("70-79",), ("80+",)
]
orden = spark.createDataFrame(grupos, ["grupo_edad"])

letalidad_base = (
    df.filter(col("grupo_edad") != "No informada")
    .groupBy("grupo_edad")
    .agg(
        count("*").alias("casos"),
        spark_sum("fallecido").alias("fallecidos")
    )
)

tabla3 = (
    orden.join(letalidad_base, "grupo_edad", "left")
    .fillna(0, subset=["casos", "fallecidos"])
    .withColumn(
        "letalidad_porcentaje",
        when(col("casos") > 0,
             spark_round(col("fallecidos") * 100.0 / col("casos"), 2))
        .otherwise(0.0)
    )
    .orderBy("grupo_edad")
)



# PREGUNTA 4: días entre inicio de síntomas y notificación
dias = df.withColumn(
    "dias_hasta_notificacion",
    datediff(col("notificacion"), col("inicio_sintomas"))
)

tabla4 = (
    dias.filter(
        col("notificacion").isNotNull()
        & col("inicio_sintomas").isNotNull()
        & (col("dias_hasta_notificacion") >= 0)
        & (col("dias_hasta_notificacion") <= 365)
    )
    .groupBy("departamento")
    .agg(
        spark_round(avg("dias_hasta_notificacion"), 2)
            .alias("promedio_dias"),
        count("*").alias("registros_validos")
    )
    .orderBy(col("promedio_dias").desc())
)



# PREGUNTA 5: calidad de datos
def contar(condicion):
    return df.filter(condicion).count()

nulos_id = contar(col("id_caso").isNull())
nulos_edad = contar(col("edad_num").isNull())
edad_invalida = contar(
    col("edad_num").isNotNull()
    & ((col("edad_num") < 0) | (col("edad_num") > 120))
)
sin_departamento = contar(col("departamento") == "No informado")
sin_notificacion = contar(col("notificacion").isNull())
sin_inicio = contar(col("inicio_sintomas").isNull())
fechas_incoherentes = contar(
    col("notificacion").isNotNull()
    & col("inicio_sintomas").isNotNull()
    & (col("inicio_sintomas") > col("notificacion"))
)

indicadores = [
    ("Registros seleccionados", total_original),
    ("Duplicados exactos eliminados", duplicados),
    ("Registros finales", total_limpio),
    ("ID de caso nulo", nulos_id),
    ("Edad nula o no numérica", nulos_edad),
    ("Edad fuera del rango 0-120", edad_invalida),
    ("Departamento no informado", sin_departamento),
    ("Fecha de notificación inválida", sin_notificacion),
    ("Inicio de síntomas no informado o inválido", sin_inicio),
    ("Inicio posterior a notificación", fechas_incoherentes)
]

tabla5 = spark.createDataFrame(
    [
        (nombre, int(cantidad),
         round(cantidad * 100.0 / total_limpio, 2) if total_limpio else 0.0)
        for nombre, cantidad in indicadores
    ],
    ["indicador", "cantidad", "porcentaje"]
)

# Mostrar y guardar resultados en CSV
os.makedirs(SALIDA, exist_ok=True)

resultados = [
    ("01_casos_departamento_mes", tabla1),
    ("01b_total_por_departamento", total_departamento),
    ("02_casos_edad_sexo", tabla2),
    ("03_letalidad_edad", tabla3),
    ("04_tiempo_notificacion", tabla4),
    ("05_calidad_datos", tabla5)
]

print("\nPREGUNTA 1: CASOS POR DEPARTAMENTO Y MES")
tabla1.show(30, truncate=False)

print("\nTOTAL POR DEPARTAMENTO (NOMBRES)")
total_departamento.show(30, truncate=False)

print("\nPREGUNTA 2: CASOS POR GRUPO DE EDAD Y SEXO")
tabla2.show(100, truncate=False)

print("\nPREGUNTA 3: CASOS, FALLECIDOS Y LETALIDAD")
tabla3.show(20, truncate=False)

print("\nPREGUNTA 4: PROMEDIO DE DÍAS HASTA NOTIFICACIÓN")
tabla4.show(30, truncate=False)

print("\nPREGUNTA 5: CALIDAD DE LOS DATOS")
tabla5.show(50, truncate=False)

for nombre, tabla in resultados:
    destino = os.path.join(SALIDA, nombre)
    (tabla.coalesce(1)
     .write.mode("overwrite")
     .option("header", True)
     .csv(destino))
    print("CSV guardado:", destino)

print("\nANÁLISIS FINALIZADO")
print("Registros seleccionados:", total_original)
print("Duplicados exactos eliminados:", duplicados)
print("Registros finales:", total_limpio)

spark.stop()
